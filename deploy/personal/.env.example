# Generate a unique value before first start.
SESSION_SECRET=replace-with-a-long-random-value

# Required when secure cookies are enabled behind HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://new.example.com

# Keep relay error logs available for personal failover diagnostics.
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=personal-new-api
